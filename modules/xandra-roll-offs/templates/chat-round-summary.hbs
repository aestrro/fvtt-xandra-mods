<div class="xandra-roll-offs-chat xro-round-summary">
  <div class="xro-chat-header">
    <span class="xro-chat-title">{{localize 'XANDRA_ROLL_OFFS.Labels.RoundSummary' round=round}}</span>
  </div>
  <ul class="xro-roll-list">
    {{#each rolls}}
    <li class="{{#if (eq @index 0)}}xro-high{{/if}}">
      <span class="xro-user">{{name}}</span>
      <span class="xro-value">{{value}}</span>
    </li>
    {{/each}}
  </ul>
  {{#if isWinner}}
  <p class="xro-winner">{{resultText}}</p>
  {{else}}
  <p class="xro-tie">{{resultText}}</p>
  {{/if}}
</div>
