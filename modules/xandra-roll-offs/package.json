{
  "name": "xandra-roll-offs",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "GM-run, multi-round roll-off contests with automatic tiebreak resolution and persistent win tallies.",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
